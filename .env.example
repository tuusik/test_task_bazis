API_KEY=local-development-api-key

APP_PORT=8000

POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments

RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments

DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://payments:payments@localhost:5672/

WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_CLAIM_TTL_SECONDS=30
WEBHOOK_CLAIM_RETRY_SECONDS=0.5
# Включать только для локального webhook, недоступного из публичной сети.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
CONSUMER_PROCESSING_TIME=[2,5]
CONSUMER_PROCESS_CHANCE=[90,10]
CONSUMER_RETRY_ATTEMPTS=3
CONSUMER_RETRY_BASE_SECONDS=1

OUTBOX_POLL_SECONDS=1
OUTBOX_BATCH_SIZE=50
OUTBOX_CLAIM_TTL_SECONDS=30
OUTBOX_PUBLISH_TIMEOUT_SECONDS=10
OUTBOX_RETRY_BASE_SECONDS=1
OUTBOX_MAX_BACKOFF_SECONDS=60
